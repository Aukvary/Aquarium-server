# PostgreSQL Database Configuration
POSTGRES_USER=admin
POSTGRES_PASSWORD=password
POSTGRES_DB=aquarium
POSTGRES_PORT=5421

# Application Exposed Ports
GRPC_PORT=8081
HTTP_PORT=8080

# Service Security & Authentication Keys (Minimum 32 characters in production)
INTERNAL_KEY=aquarium_internal_secret_key_minimum_32_chars
INVITE_KEY=aquarium_invite_secret_key_minimum_32_chars
